---

---

<button id="theme-toggle" title="Toggle theme" aria-label="Toggle theme">
  <!-- Light (sun) -->
  <svg
    id="icon-light"
    xmlns="http://www.w3.org/2000/svg"
    width="28"
    height="28"
    viewBox="0 0 24 24"
    fill="none"
    stroke="white"
    stroke-width="2"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="5"></circle>
    <line x1="12" y1="1" x2="12" y2="3"></line>
    <line x1="12" y1="21" x2="12" y2="23"></line>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
    <line x1="1" y1="12" x2="3" y2="12"></line>
    <line x1="21" y1="12" x2="23" y2="12"></line>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
  </svg>

  <!-- Dark (moon) -->
  <svg
    id="icon-dark"
    xmlns="http://www.w3.org/2000/svg"
    width="28"
    height="28"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
    style="display:none"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script is:inline>
  (() => {
    // Only light | dark is ever stored. If nothing is stored, follow the OS.
    const stored = localStorage.getItem("theme");
    const isDark = stored
      ? stored === "dark"
      : window.matchMedia("(prefers-color-scheme: dark)").matches;

    const root = document.documentElement;
    root.classList.remove("dark", "light");
    root.classList.add(isDark ? "dark" : "light");
  })();
</script>

<script>
  const root = document.documentElement;
  const btn = document.getElementById("theme-toggle");
  const lightIcon = document.getElementById("icon-light")!;
  const darkIcon = document.getElementById("icon-dark")!;

  type Theme = "light" | "dark";

  /** Read the theme to display: stored value, else the OS preference. */
  function currentTheme(): Theme {
    const stored = localStorage.getItem("theme") as Theme | null;
    if (stored === "light" || stored === "dark") return stored;
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  }

  /** Update which icon is visible based on the active theme. */
  function updateIcon(theme: Theme) {
    lightIcon.style.display = theme === "light" ? "" : "none";
    darkIcon.style.display = theme === "dark" ? "" : "none";
  }

  /** Apply a theme. Writing 'light'/'dark' means the user chose explicitly. */
  function applyTheme(theme: Theme) {
    localStorage.setItem("theme", theme);
    root.classList.remove("dark", "light");
    root.classList.add(theme);
    updateIcon(theme);
  }

  // Initial icon state
  updateIcon(currentTheme());

  // If the user hasn't chosen (nothing stored), follow live OS changes.
  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", (e) => {
      if (localStorage.getItem("theme")) return; // explicit choice — don't override
      root.classList.remove("dark", "light");
      root.classList.add(e.matches ? "dark" : "light");
      updateIcon(e.matches ? "dark" : "light");
    });

  btn?.addEventListener("click", () => {
    const next: Theme = currentTheme() === "dark" ? "light" : "dark";

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const startVT = (document as any).startViewTransition?.bind(document);

    // No View Transitions support, or user prefers reduced motion → hard switch
    if (!startVT || reduceMotion) {
      applyTheme(next);
      return;
    }

    // Circular reveal expanding from the button's center
    const rect = btn.getBoundingClientRect();
    const x = rect.width ? rect.left + rect.width / 2 : window.innerWidth;
    const y = rect.height ? rect.top + rect.height / 2 : 0;
    const endRadius = Math.hypot(
      Math.max(x, window.innerWidth - x),
      Math.max(y, window.innerHeight - y),
    );

    root.style.setProperty("--theme-x", `${x}px`);
    root.style.setProperty("--theme-y", `${y}px`);
    root.style.setProperty("--theme-end-r", `${endRadius}px`);
    root.classList.add("theme-switching");

    const transition = startVT(() => applyTheme(next));
    transition.finished.finally(() => root.classList.remove("theme-switching"));
  });
</script>

<style>
  button {
    background-color: #9b2e75;
    box-shadow:
      inset 0 4px 4px 0px rgba(255, 255, 255, 0.35),
      inset 0 -4px 4px 0px rgba(0, 0, 0, 0.3),
      0 4px 15px 0px rgba(0, 0, 0, 0.15);
    border-radius: 10px 0px 10px 0px;
    border: none;
    padding: 0.4rem;
    cursor: pointer;
    color: rgb(var(--black));
    display: flex;
    align-items: center;
    transition:
      background 0.2s,
      opacity 0.2s;
  }
  button:hover {
    background-color: #791d59;
  }

  /* Both icons stack — only one is shown at a time via display:none toggling in JS */
  #icon-light,
  #icon-dark {
    transition:
      transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 0.25s ease;
  }

  /* Optional flourish — sun rays spin on hover, moon tilts */
  button:hover #icon-light {
    transform: rotate(30deg);
  }
  button:hover #icon-dark {
    transform: rotate(-10deg);
  }

  @media (prefers-reduced-motion: reduce) {
    button,
    #icon-light,
    #icon-dark {
      transition: none;
    }
    button:hover #icon-light,
    button:hover #icon-dark {
      transform: none;
    }
  }
</style>
