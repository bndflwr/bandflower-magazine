---
import "../styles/global.css";
import { Font } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Marquee from "../components/Marquee.astro";
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";

const pageTitle = "Bandflower Magazine";
---

<html lang="en">
  <head>
    <link rel="stylesheet" href="https://use.typekit.net/ksc8ilf.css" />
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <Font cssVariable="--font-blackout-midnight" preload />
    <Font cssVariable="--font-blackout-two-am" preload />
    <Font cssVariable="--font-azeret-mono" preload />
    <PagefindConfig />

    <style>
      .sectiontitle {
        font-family: "Blackout Midnight";
        font-size: 4rem;
      }
    </style>
  </head>
  <body>
    <BaseLayout>
      <main>
        <h2 class="sectiontitle">LATEST POSTS</h2>

        <p>ipod here</p>

        <form id="poll-form" class="poll-form">
          <label>
            <input type="radio" name="vote" value="yes" /> Yes
          </label>
          <label>
            <input type="radio" name="vote" value="no" /> No
          </label>
          <button type="submit" class="vote-button"> Vote </button>
        </form>

        <p>mailing list</p>

        <Marquee marqueeHeadline="NEWSFLASH" />

        <h2 class="sectiontitle">PHOTO GALLERIES</h2>

        <Marquee marqueeHeadline="REVIEWS" />
      </main>
    </BaseLayout>
  </body>
</html>
